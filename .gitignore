# =============================================================================
# SoyMutDB Next — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
**/node_modules/

# ---------------------------------------------------------------------------
# Build outputs
# ---------------------------------------------------------------------------
dist/
build/
# `scripts/build-pages-artifact.sh` output consumed by the Pages publisher; it is
# an upload input, never a committed tree.
pages-dist/
# `dist/` above matches only a directory named exactly `dist`, not the
# `dist-internal` tree some build paths stage; ignore it explicitly.
dist-internal/
# `build/` above matches at any depth, so it silently swallowed
# packages/shared/src/build/ — the shared CSP composer and inline-script hasher
# that apps/web/scripts/finalize-csp.ts, apps/jbrowse/scripts/inject-headers-origins.ts
# and apps/web/src/lib/deployment.ts all import. The files existed on the
# authoring machine, so every local build passed, while a clean clone had no
# source for @soymutdb/shared/build/* and could not build either app. Same
# failure class as .cnb/env/ below; re-include the tracked source directory.
!packages/shared/src/build/
.turbo/
**/.umi*/
target/
*.tsbuildinfo
*.pyc
__pycache__/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cargo/

# Rust (core-rs hotpath)
apps/core-rs/target/
Cargo.lock.bak

# Tauri
src-tauri/target/
src-tauri/Cargo.lock

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Test / coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright-report-*/
test-results-*/
/allure-results/
/htmlcov/

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
.cache/
.parcel-cache/
.vite/
.eslintcache
*.local

# Deepwork session state (local OpenCode context, never commit)
.slim/deepwork/
.opencode/

# ---------------------------------------------------------------------------
# Hermes runtime (NOT project code)
# ---------------------------------------------------------------------------
.hermes/
skills/
.agent-loop-runner.cjs
.cursor-openai-bridge.cjs
.ark-crowdtest-display-prompt.txt
hermes-prompt-v2.txt
.bashrc

# ---------------------------------------------------------------------------
# System / user directories that may be in $HOME-as-project-root
# ---------------------------------------------------------------------------
.local/
.npm/
.cache/
.ssh/
.config/
.bash_history
.profile
.zshrc
.inputrc
.viminfo
.gitconfig
.python_history
.npmrc
.yarnrc
.pki/
.mozilla/
.fonts/
.themes/
.icons/

# ---------------------------------------------------------------------------
# Trash (old agent outputs retained for safety)
# ---------------------------------------------------------------------------
.trash/

# ---------------------------------------------------------------------------
# Generated artifacts & reports (regenerated on every review run)
# ---------------------------------------------------------------------------
artifacts/
!artifacts/.gitkeep
tools/code-review/reports/

# ---------------------------------------------------------------------------
# Python virtualenv
# ---------------------------------------------------------------------------
.venv/
venv/
env/
# `env/` above is a virtualenv pattern and matches at any depth, which silently
# swallowed .cnb/env/ — the CNB build environment image and release config that
# .cnb.yml references by path. They were "added" repeatedly and never committed;
# only a local contract test noticed, a remote build later. Re-include the
# tracked delivery directory explicitly.
!/.cnb/env/

# ---------------------------------------------------------------------------
# Docker volumes / local dev data
# ---------------------------------------------------------------------------
infra/docker/volumes/
postgres-data/
redis-data/
clickhouse-data/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
.soy_lock
.DEREK
*.pid
*.seed

# ---------------------------------------------------------------------------
# Hermes runtime & user home directories (project lives in $HOME)
# ---------------------------------------------------------------------------

# Review reports & local pip config
reports/
.pip/

# Project .npmrc is committed (npmmirror registry, no secrets) so Docker
# COPY .npmrc works and local installs stay fast.
!/.npmrc
apps/api/.venv

# AgentTeams runtime state
.agent-teams/

# Local AI work logs (project-level conventions/checkpoints remain trackable)
.ai-memory/*/
!.ai-memory/project_memory.md
!.ai-memory/handoff.md

# Local no-Docker deployment data (conda envs, data plane, logs) — created by the local deploy flow
.deploy/

# Workspace-local Mamba validation runtime (PostgreSQL binaries, data and logs)
.mamba-root/
.validation/

# Local service state and generated validation output (never release inputs)
dump.rdb
temp-*.rdb
appendonlydir/
apps/worker/celerybeat-schedule
e2e/visual-artifacts/
eslint_out.txt
tsc_out.txt

# 本地 pnpm 运行状态与一次性测试报告（非源码）
.pnpm-state/
# PNPM_HOME redirect used on this machine: the global store is read-only, so
# pnpm 12 needs a writable home inside the workspace (LOCAL-RUN-ENV.md §1).
/.ph/
apps/admin/.trash-vitest-report.json

# 本机 PostgreSQL 开发集群（.ai-memory/LOCAL-RUN-ENV.md 第 7 节）
# 绝不入库：集群含二进制与运行时状态，且体积很大
.local-pg/

# A1 measurement evidence and isolated build outputs
/apps/.a1-*.log
/apps/.a1-*-stats.json
/apps/.a1-*-chunks.txt
/apps/.a1-baseline.start
/apps/web/dist-a1-*/
/.probe-out/a1-*

# Chart dependency closure manifests: read by scripts/chart_closure_budget.py
# from .build/, which is generated per build and must never be committed or
# published into dist/.
/.build/
# generated by apps/web/scripts/sync-pdf-worker.mjs (pdf.js worker)
apps/web/public/pdf.worker.min.mjs

# Ad-hoc Playwright probe scripts written by hand while debugging a page.
# They are one-off, unreferenced, and superseded by the real specs under
# e2e/tests/. Keep them out of the repository.
/e2e/dbg*.mjs

# Superseded scan output only. Keep the referenced 20261015 evidence visible
# to git status; newer retained validation evidence must not be hidden.
/docs/dev/ant-design-scan-20261014/
