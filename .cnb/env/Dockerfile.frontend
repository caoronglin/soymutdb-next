# =============================================================================
# SoyMutDB — CNB frontend verification environment
# =============================================================================
# Referenced by .cnb.yml as the build environment for:
#
#   scripts/ci-job-steps.sh run frontend   (PR / push / manual verify stages)
#
# Why this image exists
#   `scripts/verify-frontend-artifacts.sh` ends with the OpenAPI client contract
#   (`packages/api-client/scripts/check-contract.sh`), which exports
#   `app.main`'s OpenAPI document from `apps/api/.venv/bin/python`. The gate
#   therefore needs BOTH toolchains in one container.
#
#   The stage used to run on `node:26.13.0`, which carries no Python, so the
#   build failed with:
#
#     scripts/check-contract.sh: line 18: /workspace/apps/api/.venv/bin/python:
#     No such file or directory
#
#   The GitHub mirror never hit this because `actions/setup-python` puts a
#   system interpreter on PATH. Pinning a dual-toolchain image here is what lets
#   both providers run identical bytes instead of one silently skipping a gate.
#
# Design: Python base, Node installed from the official tarball
#   An earlier revision took the opposite shape — `FROM node:26.13.0` plus
#   `COPY --from=python:3.15 /usr/local /usr/local` — and the image build failed
#   on the first real CNB run:
#
#     python3: /lib/x86_64-linux-gnu/libm.so.6: version `GLIBC_2.38' not found
#              (required by /usr/local/lib/libpython3.15.so.1.0)
#     python3: /lib/x86_64-linux-gnu/libc.so.6: version `GLIBC_2.38' not found
#
#   `COPY --from` moves the interpreter's binary and shared libraries but NOT
#   the C library underneath them. python:3.15 sits on a newer Debian (glibc
#   2.38+) than node:26.13.0 (bookworm, glibc 2.36), so the copied interpreter
#   could never load. Installing a shared-library list was necessary but not
#   sufficient, and glibc itself cannot be swapped in a `COPY`.
#
#   Going the other way is safe: the Node release tarball is linked against a
#   glibc FLOOR well below what Debian trixie provides, so it runs on the newer
#   base. The Node version and the tarball's SHA256 are both pinned and
#   verified at build time, so neither can move without a reviewed change.
#
# Constraints
#   * The base tag MUST stay version-pinned. scripts/check-toolchain-pins.py
#     rejects an untagged or `:latest` FROM in .cnb/env/*.
#   * The Python base MUST match PYTHON_VERSION (3.15).
#   * No credentials: this image only builds, tests and exports a schema.
# =============================================================================

# Matches PYTHON_VERSION in scripts/ci-job-steps.sh and the API job's image.
FROM python:3.15

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Must match NODE_VERSION / .nvmrc. The SHA256s are the published values from
# https://nodejs.org/dist/<version>/SHASUMS256.txt and are verified before the
# tarball is unpacked: `curl | tar` would let a mirror swap the binary under a
# reviewed pin.
ARG NODE_VERSION=26.13.0
ARG NODE_SHA256_X64=d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997
ARG NODE_SHA256_ARM64=406fe3fbde1c054adff8b297c16fdb5af6659db327c1ac8acd46b56ef1af9a92
# Must match PNPM_VERSION in scripts/{setup-workspace,ci-job-steps}.sh and
# package.json's packageManager; scripts/check-toolchain-pins.py enforces it.
ARG PNPM_VERSION=12.11.2

# coreutils    sha256sum for the Node tarball verification
# ca-certs     pnpm and the OpenAPI export both reach HTTPS endpoints
# xz-utils     the Node release tarball is .tar.xz
# libstdc++6   the official Node binary links against it; python:3.14
#              (Debian slim) ships libgcc-s1 but not the C++ runtime
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      coreutils \
      curl \
      git \
      libstdc++6 \
      make \
      xz-utils; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) node_arch="x64"; node_sha="${NODE_SHA256_X64}" ;; \
      arm64) node_arch="arm64"; node_sha="${NODE_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    tarball="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}" \
      --output "/tmp/${tarball}"; \
    echo "${node_sha}  /tmp/${tarball}" | sha256sum --check --strict -; \
    tar -xJf "/tmp/${tarball}" -C /usr/local --strip-components=1 \
      --exclude CHANGELOG.md --exclude LICENSE --exclude README.md; \
    rm -f "/tmp/${tarball}"; \
    node --version; \
    npm --version

# Fail loudly at build time if either toolchain drifted. A broken interpreter or
# a missing runtime library must break the image build, not the first contract
# gate of a paid remote run.
RUN node --version \
 && python3 --version \
 && python3 -m venv /tmp/venv-check \
 && /tmp/venv-check/bin/python -c "import ssl, sqlite3, lzma, bz2, ctypes, uuid" \
 && rm -rf /tmp/venv-check

# ---------------------------------------------------------------------------
# Pre-warm the pnpm store into the IMAGE
# ---------------------------------------------------------------------------
# CNB shares a path declared with the Docker `VOLUME` instruction between the
# pipeline container and every later container of the same pipeline
# (docs.cnb.cool/zh/build/build-env.md, "Volume 共享"). That is the only
# supported way to ship a warm dependency store with a build environment — the
# image filesystem is not what a pipeline's `docker.volumes` mount carries, so a
# store written below /cache would otherwise be discarded by the very mount that
# is supposed to make it persistent.
#
# Why it matters: `.cnb.yml` links `pnpm install` to `/cache/pnpm-store`. If the
# node mounts that path for the first time, the store starts EMPTY, and
# `--frozen-lockfile` re-resolves and re-downloads every tarball on the first
# run of every environment — the exact cost the store mount exists to remove.
# Baking the lockfile-selected package tarballs here makes the first run a
# store-link operation instead of a full network download.
#
# `pnpm fetch` preloads the package tarballs selected by the checked-out
# lockfile; it does not install dependencies or create a node_modules tree.
# `fetch` has no `--lockfile-only` option (that option belongs to `pnpm
# install`), so keeping the command to the official fetch interface makes the
# warm store real rather than a command that fails before the image is built.
# The warm-up reads the checked-out lockfile, so the manifests have to exist in
# the image BEFORE it runs. They did not: the stage ran `pnpm fetch` against an
# empty /workspace, and every remote build died in Prepare with
#
#   ERR_PNPM_NO_LOCKFILE
#
# before a single gate ran.
#
# Only files named in the pipeline's `docker.build.by` reach the build context --
# grammar.md is explicit: "未出现在 by 列表中的文件，在构建镜像时不会被 COPY 进
# 镜像（Dockerfile 本身除外）". So this COPY list and that `by` list have to agree;
# `by` carries `.npmrc` for exactly this reason. `pnpm-workspace.yaml` is what
# tells pnpm the lockfile is a workspace lockfile, and `.npmrc` keeps the fetch
# on the pinned registry.
#
# The per-package manifests are deliberately NOT copied: the context does not
# carry them, and `pnpm fetch` selects tarballs from the lockfile alone.
# Verified with the pinned pnpm 12.11.2 -- these four files resolve the whole
# lockfile, while an empty directory fails with ERR_PNPM_NO_LOCKFILE.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# pnpm is installed with npm, NOT corepack.
#
# Node 25+ no longer ships corepack in its distribution, so `corepack enable`
# here failed with `corepack: command not found` on the Node 26.13.0 tarball
# (CNB build cnb-on5-1k4i8kkap, stage Prepare, 2026-10-10) and the pipeline
# image could not be built at all. npm is still bundled with Node, and
# `npm install -g pnpm@<pinned>` puts the exact reviewed version on PATH --
# the same pin corepack used to resolve from `packageManager`, still enforced
# by scripts/check-toolchain-pins.py.
RUN set -eux; \
    mkdir -p /cache/pnpm-store; \
    npm install --global --no-fund --no-audit "pnpm@${PNPM_VERSION}"; \
    pnpm --version; \
    pnpm config set store-dir /cache/pnpm-store; \
    pnpm fetch --ignore-scripts; \
    du -sh /cache/pnpm-store

# Declared AFTER the warm-up above: declaring a volume on a path that does not
# exist yet makes the runtime/engine copy whatever it finds there when the
# pipeline container starts.
VOLUME /cache/pnpm-store

WORKDIR /workspace
