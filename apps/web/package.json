{
  "name": "@soymutdb/web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB public and internal research portal — React 19, Umi Max 4, Ant Design 6 and ProComponents v3",
  "scripts": {
    "dev": "max dev --host 0.0.0.0 --port 5173",
    "build": "tsx scripts/build-sites.ts",
    "build:sites": "tsx scripts/build-sites.ts",
    "preview": "python3 -m http.server --bind ${HOST:-0.0.0.0} ${PORT:-4173} --directory dist/external",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ssg:routes": "tsx scripts/generate-static-routes.ts",
    "ssg:compress": "tsx scripts/gzip-compress.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/pro-components": "catalog:",
    "@fontsource/fraunces": "^5.1.0",
