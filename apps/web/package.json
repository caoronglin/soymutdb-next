{
  "name": "@soymutdb/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB public portal — Awwwards-grade frontend for the multi-species mutant database (soybean as the first/default species)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/ssg-build.ts && tsx scripts/generate-samples.ts && tsx scripts/fetch-content-snapshot.ts && tsx scripts/ssg-content.ts && tsx scripts/embed-page-definitions.ts && tsx scripts/gzip-compress.ts && node scripts/gen-sw.js",
    "preview": "vite preview --port 4173",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ssg:build": "tsx scripts/ssg-build.ts",
    "ssg:samples": "tsx scripts/generate-samples.ts",
    "ssg:compress": "tsx scripts/gzip-compress.ts",
    "clean": "rimraf dist .turbo",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.22.0",
    "@ant-design/icons": "^5.5.0",
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/i18n": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@tanstack/router-devtools": "^1.167.1",
    "antd": "catalog:",
    "cytoscape": "^3.34.1",
    "dayjs": "^1.11.0",
    "dompurify": "^3.2.0",
    "echarts": "^5.5.1",
    "highlight.js": "^11.11.1",
    "i18next": "^24.2.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-generator": "^1.167.24",
    "@tanstack/router-plugin": "^1.168.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
