    "@fontsource/jetbrains-mono": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/i18n": "workspace:*",
    "@soymutdb/query-keys": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-react": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.11.0",
    "antd": "catalog:",
    "cytoscape": "^3.34.1",
    "dayjs": "^1.11.0",
    "dompurify": "^3.2.0",
    "echarts": "catalog:",
    "highlight.js": "^11.11.1",
    "i18next": "^24.2.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9",
    "pdfjs-dist": "^4.10.38",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.4.0",
    "zod": "^3.24.0",
    "@umijs/max": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-vue": "catalog:",
