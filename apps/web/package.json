{
  "name": "@soymutdb/web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB public portal \u2014 Vue/Vite/SSG static site (canonical web artifact)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && tsx scripts/generate-static-routes.ts && tsx scripts/finalize-csp.ts && tsx scripts/gzip-compress.ts && node scripts/gen-sw.js && tsx scripts/release-manifest.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "ssg:routes": "tsx scripts/generate-static-routes.ts",
    "ssg:compress": "tsx scripts/gzip-compress.ts",
    "build:sites": "tsx scripts/build-sites.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/genome-view-model": "workspace:*",
    "@soymutdb/i18n-core": "workspace:*",
    "@soymutdb/query-keys": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-vue": "workspace:*",
    "@tanstack/vue-query": "catalog:",
    "dompurify": "^3.2.0",
    "i18next": "24.2.0",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.0.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.0"
  }
}
