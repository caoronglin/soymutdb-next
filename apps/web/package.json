{
  "name": "@soymutdb/web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB public and internal research portal \u2014 React 19, Umi Max 4, Ant Design 6 and ProComponents v3",
  "scripts": {
    "dev": "node scripts/sync-pdf-worker.mjs && max dev --host 0.0.0.0 --port 5173",
    "build": "tsx scripts/build-sites.ts",
    "build:sites": "tsx scripts/build-sites.ts",
    "preview": "python3 -m http.server --bind ${HOST:-0.0.0.0} ${PORT:-4173} --directory dist/external",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ssg:routes": "tsx scripts/generate-static-routes.ts",
    "ssg:compress": "tsx scripts/gzip-compress.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "catalog:",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/charts": "workspace:*",
    "@soymutdb/genome-view": "workspace:*",
    "@soymutdb/i18n": "workspace:*",
    "@soymutdb/query-keys": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-react": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@umijs/max": "catalog:",
    "antd": "catalog:",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.7",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@soymutdb/i18n-core": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "rimraf": "^6.1.3",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
