# ============================================================================
# SoyMutDB Portal (apps/web) — build-time environment variables
#
# VITE_* variables are inlined into the bundle at BUILD time by Vite.
# They are public by nature — NEVER put secrets, tokens or passwords here.
# Set them in the Cloudflare Pages dashboard (Settings > Environment
# variables) or in a local .env file for development.
#
# Reference: deploy/cloudflare.md
# ============================================================================

# --- Production build (Pages production branch) -----------------------------
VITE_API_BASE_URL=https://api.example.com
# REPLACE https://api.example.com with the real production API origin.
# Must be one of the origins in the backend's SOYMUTDB_CORS_ORIGINS allowlist
# (the backend rejects `*` and requires exact-origin matching for the
# credentials-mode fetch that uses the HttpOnly refresh cookie).

VITE_CDN_ENABLED=false
# Keep false: all libraries are bundled locally (Fontsource fonts, echarts,
# gsap, ...) so the CSP stays `script-src 'self'`-friendly.

VITE_JBROWSE_URL=https://jbrowse.example.com
# REPLACE with the deployed JBrowse origin (used for the iframe on /browse).
# Must be listed in the portal CSP `frame-src` (apps/web/public/_headers and
# the <meta> CSP in apps/web/index.html).

VITE_CLOUDFLARE_ANALYTICS_TOKEN=
# Cloudflare Web Analytics beacon token (C3). Optional — when set, the build
# injects the one-line static beacon (<script src="https://static.cloudflare
# insights.com/beacon.min.js" data-cf-beacon="{...}">) into index.html and
# widens the <meta> CSP for the beacon origins. When empty/unset the beacon is
# NOT injected and the CSP stays untouched (default local behaviour).
#
# This is NOT a secret in the traditional sense (it is shipped in the public
# HTML, VITE_* vars are build-time and public by nature), but treat it as a
# site identifier: set it only in the Cloudflare Pages dashboard
# (Settings > Environment variables > VITE_CLOUDFLARE_ANALYTICS_TOKEN) for
# the soymutdb-web project — Production AND Preview environments.
#
# How to obtain it: Cloudflare Dashboard → Analytics & Logs → Web Analytics →
# Add a site → copy the token from the installation snippet. The beacon works
# on static/gh-pages hosting without proxying the domain through Cloudflare.
#
# Full steps: deploy/cloudflare.md §"Web Analytics" and the Admin console
# page "Analytics Settings" (/analytics-settings).

# --- Preview build (Pages preview deployments) ------------------------------
# Preview deployments MUST point at the STAGING API — never production.
# Uncomment and set in the Pages dashboard "Preview" environment:
# VITE_API_BASE_URL=https://api-staging.example.com
# VITE_CDN_ENABLED=false
# VITE_JBROWSE_URL=https://jbrowse-staging.example.com
#
# The preview origin (e.g. https://<hash>.<project>.pages.dev) must be added
# to the STAGING backend's SOYMUTDB_CORS_ORIGINS before login works there.
# Note: previews share the repo's _headers / meta CSP, so for preview testing
# also replace the CSP `connect-src`/`frame-src` placeholders with the
# STAGING origins (see deploy/cloudflare.md, "Preview deployments").

# --- Optional ---------------------------------------------------------------
# VITE_DEMO_MODE=false

VITE_SW_ENABLED=true
# Service Worker 静态资源缓存（生产构建自动注册，见 docs/design/service-worker.md）。
# 设为 false 可禁用（例如部署环境不支持 SW、或需要完全无缓存行为）。
# 默认开启；仅生产构建（import.meta.env.PROD）生效，开发模式不注册。
