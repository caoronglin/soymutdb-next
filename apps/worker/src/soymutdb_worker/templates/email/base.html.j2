<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% block title %}SoyMutDB{% endblock %}</title>
<style>
  /* Unified SoyMutDB email layout — inline CSS (no external assets). */
  body {
    margin: 0;
    padding: 0;
    background-color: #f4f6f4;
    font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC",
      "Microsoft YaHei", "Segoe UI", Helvetica, Arial, sans-serif;
    color: #1c2b24;
    -webkit-text-size-adjust: 100%;
  }
  .shell {
    width: 100%;
    background-color: #f4f6f4;
    padding: 24px 12px;
  }
  .card {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e2e8e2;
  }
  .brand {
    background-color: #2f6f4f; /* science green */
    padding: 20px 28px;
  }
  .brand-name {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .brand-tag {
    color: #d7e8dc;
    font-size: 12px;
  }
  .body {
    padding: 28px;
    font-size: 14px;
    line-height: 1.7;
    color: #1c2b24;
  }
  .body h1 {
    font-size: 18px;
    margin: 0 0 12px;
    color: #1c2b24;
  }
  .body p {
    margin: 0 0 14px;
  }
  .summary {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 20px;
  }
  .summary th,
  .summary td {
    border: 1px solid #e2e8e2;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    vertical-align: top;
  }
  .summary th {
    background-color: #f0f5f1;
    color: #2f6f4f;
    font-weight: 600;
    width: 34%;
    white-space: nowrap;
  }
  .gene-list {
    margin: 6px 0 0;
    padding-left: 20px;
  }
  .gene-list li {
    margin: 2px 0;
    font-family: "HarmonyOS Sans", "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px;
  }
  .btn {
    display: inline-block;
    background-color: #2f6f4f;
    color: #ffffff !important;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
  }
  .muted {
    color: #5f6f66;
    font-size: 12px;
  }
  .footer {
    background-color: #f0f5f1;
    padding: 16px 28px;
    font-size: 12px;
    color: #5f6f66;
    line-height: 1.6;
  }
  @media (max-width: 480px) {
    .body { padding: 20px; }
  }
</style>
</head>
<body>
<table role="presentation" class="shell" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      <table role="presentation" class="card" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="brand">
            <div class="brand-name">SoyMutDB</div>
            <div class="brand-tag">Soybean mutation database</div>
          </td>
        </tr>
        <tr>
          <td class="body">
            {% block body %}{% endblock %}
          </td>
        </tr>
        <tr>
          <td class="footer">
            SoyMutDB · Soybean Mutation Database<br>
            {% block footer_extra %}{% endblock %}
            This is an automated message — please do not reply directly.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
