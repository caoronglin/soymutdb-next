{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoyMutDB Admin",
  "version": "2.0.0",
  "identifier": "org.soymutdb.admin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoyMutDB Admin Console",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 http://[::1]:8000 ws://127.0.0.1:8000 ws://localhost:8000;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Science",
    "shortDescription": "SoyMutDB administration console",
    "longDescription": "Native desktop admin console for managing SoyMutDB widgets, layouts, users, data sources, and analytics.",
    "copyright": "© 2026 SoyMutDB Consortium",
    "publisher": "SoyMutDB Consortium"
  }
}
