{
  "name": "@soymutdb/admin",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB administrator console \u2014 React 19, Umi Max 4, Ant Design 6 and ProComponents v3",
  "scripts": {
    "dev": "max dev --host 0.0.0.0 --port 5174",
    "build": "max build && tsx scripts/finalize-csp.ts",
    "preview": "python3 -m http.server --bind ${HOST:-0.0.0.0} ${PORT:-4174} --directory dist",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
