{
  "name": "@soymutdb/admin",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB admin console — Vue/Vite shell over the admin API",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/i18n-core": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-vue": "workspace:*",
    "@tanstack/vue-query": "catalog:",
    "i18next": "24.2.0",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.0"
  }
}
