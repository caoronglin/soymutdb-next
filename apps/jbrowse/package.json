{
  "name": "@soymutdb/jbrowse",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone SoyMutDB genome browser \u2014 React 19, Umi Max 4, Ant Design 6 and ProComponents v3",
  "scripts": {
    "dev": "max dev --host 0.0.0.0 --port 5175",
    "build": "max build && tsx scripts/build-artifact.ts",
    "test": "node --test antd-migration-contract.test.mjs bridge-contract.test.mjs locus-search.test.mjs vue-retirement-contract.test.mjs",
    "preview": "python3 -m http.server --bind ${HOST:-0.0.0.0} ${PORT:-5175} --directory dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@ant-design/pro-components": "catalog:",
    "@jbrowse/react-linear-genome-view": "^2.17.0",
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/i18n": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-react": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "antd": "catalog:",
    "lucide-react": "^0.469.0",
    "mobx": "^6.13.0",
    "mobx-react": "^9.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^15.4.0",
    "@umijs/max": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
