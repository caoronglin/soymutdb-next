{
  "name": "@soymutdb/jbrowse",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone JBrowse 2 genome browser deployment for SoyMutDB",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "build": "vite build",
    "test": "node --test antd-migration-contract.test.mjs bridge-contract.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5175",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/genome-data": "workspace:*",
    "@soymutdb/genome-view": "workspace:*",
    "@soymutdb/i18n-core": "workspace:*",
    "@soymutdb/ui-vue": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vue-tsc": "^3.2.0"
  }
}
