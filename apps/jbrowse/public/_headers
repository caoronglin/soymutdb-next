# ============================================================================
# SoyMutDB Genome Browser (apps/jbrowse) — Cloudflare Pages custom headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Rules are matched per request path; a request inherits headers from ALL
# matching rules, and duplicate headers are comma-joined. Therefore `/*`
# below deliberately carries NO Cache-Control (it would merge with the
# /assets/* rule). Cache-Control is set only by the specific rules below.
# ============================================================================

# ---------------------------------------------------------------------------
# Security headers — applied to every response (browsers ignore CSP on
# non-HTML responses, so applying it to assets is harmless).
# HSTS: Cloudflare Pages always serves HTTPS; max-age without
# includeSubDomains so the header never forces HTTPS on sibling subdomains that
# are not Cloudflare-fronted.
#
# The CSP below is the PRE-BUILD value and is same-origin only. The build
# rewrites it (apps/jbrowse/scripts/inject-headers-origins.ts, run from
# vite.config.ts) with:
#
#   connect-src     + VITE_API_BASE_URL  (and VITE_JBROWSE_DATA_URL when it is a
#                                        different origin)
#   frame-ancestors + SOYMUTDB_PORTAL_ORIGIN (+ SOYMUTDB_ADMIN_ORIGIN)
#
# It is written as a valid policy rather than as placeholder domains, because a
# partial build must never publish a placeholder host into a live artifact.
# scripts/check_artifact_headers.py fails any tree that still carries one, or
# that lacks a real connect-src origin.
# ---------------------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# ---------------------------------------------------------------------------
# Hashed build assets (Vite emits everything under /assets/ with a content
# hash in the filename) — safe to cache immutable for 1 year.
# ---------------------------------------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# HTML documents — always revalidate (same policy Cloudflare Pages sends by
# default; declared explicitly so it survives any future default change).
# ---------------------------------------------------------------------------
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
# Origins are injected at build time; see the header block above and
# deploy/cloudflare.md. Nothing to replace by hand in this file.
# ---------------------------------------------------------------------------
