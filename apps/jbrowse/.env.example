# ============================================================================
# SoyMutDB Genome Browser (apps/jbrowse) — build-time environment variables
#
# VITE_* variables are inlined into the bundle at BUILD time by Vite.
# They are public by nature — NEVER put secrets, tokens or passwords here.
#
# Reference: deploy/cloudflare.md
# ============================================================================

# --- Production build (Pages production branch) -----------------------------
VITE_API_BASE_URL=https://api.example.com
# REPLACE with the real production API origin (auth/session + API calls).
# Must be one of the origins in the backend's SOYMUTDB_CORS_ORIGINS allowlist.

VITE_JBROWSE_DATA_URL=https://api.example.com/jbrowse-data
# REPLACE with the base URL of the JBrowse data plane (reference FASTA,
# track files). Defaults to /jbrowse-data (same-origin) when unset — on
# Cloudflare the data lives on the self-managed API backend, so this MUST
# be an absolute URL. The origin must be allowed by the CSP `connect-src`
# in apps/jbrowse/public/_headers.

# --- Preview build (Pages preview deployments) ------------------------------
# Preview builds MUST use the STAGING API/data plane — never production.
# Uncomment and set in the Pages dashboard "Preview" environment:
# VITE_API_BASE_URL=https://api-staging.example.com
# VITE_JBROWSE_DATA_URL=https://api-staging.example.com/jbrowse-data
#
# The preview origin (e.g. https://<hash>.<project>.pages.dev) must be added
# to the STAGING backend's SOYMUTDB_CORS_ORIGINS before login works there.
