{#- Error / degraded state for a source.
    Supports two contexts:
      - Included from source_group.html.j2: `src` (SourceResult) is present.
      - Rendered standalone via render_source_error(): `message` and
        `source_label` are present.
-#}
{% set err_label = src.label|e if src is defined else source_label|e %}
{% set err_msg = src.error_message|e if (src is defined and src.error_message) else (message|e if message is defined else 'Results from this source could not be loaded.') %}
<div class="ext-source__error" role="alert">
  <p>
    <strong>{{ err_label }} is currently unavailable.</strong>
    <small class="ext-source__error-msg">{{ err_msg }}</small>
  </p>
</div>
