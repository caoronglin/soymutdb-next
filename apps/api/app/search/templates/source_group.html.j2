{#- Render a single source group. Expects `src: SourceResult` in context. -#}
<section class="ext-source ext-source--{{ src.status.value|e }}"
         data-source="{{ src.source.value|e }}"
         data-status="{{ src.status.value|e }}">
  <header class="ext-source__header">
    <h4 class="ext-source__name">
      <a href="{{ src.source_url|e }}" target="_blank" rel="noopener noreferrer" class="ext-source__link">
        {{ src.label|e }}
      </a>
      <span class="ext-source__badge ext-source__badge--{{ src.status.value|e }}">
        {% if src.status.value == 'ok' %}{{ src.hits|length }} hit{{ 's' if src.hits|length != 1 else '' }}
        {% elif src.status.value == 'empty' %}0 hits
        {% elif src.status.value == 'timeout' %}timeout
        {% elif src.status.value == 'circuit_open' %}unavailable
        {% elif src.status.value == 'rate_limited' %}rate limited
        {% else %}error{% endif %}
      </span>
      <small class="ext-source__elapsed">{{ '%.0f'|format(src.elapsed_ms) }}&thinsp;ms</small>
    </h4>
  </header>

  {% if src.status.value == 'ok' and src.hits %}
    <ul class="ext-source__list">
      {% for hit in src.hits %}
        {% include "result_item.html.j2" %}
      {% endfor %}
    </ul>
  {% elif src.status.value == 'empty' %}
    <p class="ext-source__empty"><em>No results from {{ src.label|e }}.</em></p>
  {% else %}
    {% include "source_error.html.j2" with context %}
  {% endif %}
</section>
