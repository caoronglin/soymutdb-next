{#- Main container for federated search results. Expects `resp: ExternalSearchResponse`. -#}
<div class="ext-search" data-query="{{ resp.query|e }}" data-elapsed="{{ '%.0f'|format(resp.elapsed_ms) }}">
  <header class="ext-search__header">
    <h3 class="ext-search__title">External search: <span class="ext-search__query">{{ resp.query|e }}</span></h3>
    <small class="ext-search__meta">
      {{ resp.total_hits }} hits across {{ resp.sources|length }} source{{ 's' if resp.sources|length != 1 else '' }}
      in {{ '%.0f'|format(resp.elapsed_ms) }}&thinsp;ms
    </small>
  </header>

  {% if not resp.any_ok and resp.sources|length > 0 %}
    <div class="ext-search__all-failed">
      <p>No external sources responded. Please try again later.</p>
    </div>
  {% endif %}

  <div class="ext-search__sources">
    {% for src in resp.sources %}
      {% include "source_group.html.j2" %}
    {% endfor %}
  </div>

  {% if resp.total_hits == 0 and resp.any_ok %}
    {% include "empty.html.j2" %}
  {% endif %}
</div>
