# SoyMutDB API environment variables
# Copy this file to .env and adjust values for your environment

# ── Application ────────────────────────────────────────────────────────────
SOYMUTDB_APP_NAME=SoyMutDB
SOYMUTDB_APP_ENV=dev
SOYMUTDB_DEBUG=false
# Keep false except when validating the unpublished sample on a loopback-only
# baseline deployment. The preview API rejects non-loopback peers.
SOYMUTDB_LOCAL_TEST_PREVIEW_ENABLED=false

# ── PostgreSQL ─────────────────────────────────────────────────────────────
SOYMUTDB_DATABASE_URL=postgresql+asyncpg://soymutdb:soymutdb_dev_password@localhost:5432/soymutdb
SOYMUTDB_DB_POOL_SIZE=20
SOYMUTDB_DB_MAX_OVERFLOW=30
SOYMUTDB_DB_ECHO=false

# ── ClickHouse ─────────────────────────────────────────────────────────────
SOYMUTDB_CLICKHOUSE_HOST=localhost
SOYMUTDB_CLICKHOUSE_PORT=8123
SOYMUTDB_CLICKHOUSE_USER=soymutdb
SOYMUTDB_CLICKHOUSE_PASSWORD=soymutdb_dev_password
SOYMUTDB_CLICKHOUSE_DATABASE=soymutdb
SOYMUTDB_CLICKHOUSE_SECURE=false

# ── Redis ──────────────────────────────────────────────────────────────────
SOYMUTDB_REDIS_URL=redis://localhost:6379/0
SOYMUTDB_CACHE_TTL_SECONDS=3600
SOYMUTDB_RATE_LIMIT_PER_MINUTE=60

# ── S3 / MinIO ─────────────────────────────────────────────────────────────
SOYMUTDB_S3_ENDPOINT=http://localhost:9000
SOYMUTDB_S3_ACCESS_KEY=minioadmin
SOYMUTDB_S3_SECRET_KEY=minioadmin
SOYMUTDB_S3_REGION=us-east-1
SOYMUTDB_S3_PUBLIC_BUCKET=genomic-data
SOYMUTDB_S3_PRIVATE_BUCKET=user-tracks
SOYMUTDB_S3_BLAST_BUCKET=blast-dbs
SOYMUTDB_S3_EXPORT_BUCKET=exports

# ── JWT ────────────────────────────────────────────────────────────────────
SOYMUTDB_JWT_SECRET=change_this_secret_in_production
SOYMUTDB_JWT_ALGORITHM=HS256
SOYMUTDB_ACCESS_TOKEN_EXPIRE_MINUTES=15
SOYMUTDB_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Celery ─────────────────────────────────────────────────────────────────
SOYMUTDB_CELERY_BROKER_URL=redis://localhost:6379/1
SOYMUTDB_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS ───────────────────────────────────────────────────────────────────
SOYMUTDB_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── BLAST ──────────────────────────────────────────────────────────────────
SOYMUTDB_BLAST_MAX_SEQUENCES=100
SOYMUTDB_BLAST_MAX_LENGTH=100000
SOYMUTDB_BLAST_DEFAULT_DB=williams82_cds
SOYMUTDB_BLAST_BIN_DIR=/usr/bin
SOYMUTDB_BLAST_CACHE_DIR=/tmp/blast_cache

# ── OpenTelemetry ──────────────────────────────────────────────────────────
SOYMUTDB_OTEL_ENABLED=false
SOYMUTDB_OTEL_SERVICE_NAME=soymutdb-api

# ── Admin ──────────────────────────────────────────────────────────────────
SOYMUTDB_ADMIN_EMAIL=admin@soymutdb.local
SOYMUTDB_ADMIN_PASSWORD=admin123

# ── Feature Flags ──────────────────────────────────────────────────────────
SOYMUTDB_FEATURE_REGISTRATION_ENABLED=true
SOYMUTDB_FEATURE_BLAST_ENABLED=true
SOYMUTDB_FEATURE_SEED_REQUESTS_ENABLED=true
