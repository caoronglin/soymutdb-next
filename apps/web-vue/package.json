{
  "name": "@soymutdb/web-vue",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SoyMutDB public portal — Vue/Vite shell (preview-only: not yet part of the published web artifact; apps/web stays canonical until the Phase 3 cutover)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/generate-static-routes.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@soymutdb/api-client": "workspace:*",
    "@soymutdb/genome-view-model": "workspace:*",
    "@soymutdb/query-keys": "workspace:*",
    "@soymutdb/shared": "workspace:*",
    "@soymutdb/ui-vue": "workspace:*",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "pinia": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "dompurify": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "tsx": "^4.19.0",
    "vue-tsc": "^3.2.0",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.0.0"
  }
}
