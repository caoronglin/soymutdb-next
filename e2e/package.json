{
  "name": "soymutdb-e2e-smoke",
  "version": "1.0.0",
  "private": true,
  "description": "Online smoke tests for the deployed SoyMutDB site (https://caoronglin.github.io/soymutdb-next/) — assets, route rendering, script health",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "test:production": "playwright test -c playwright-production.config.ts",
    "test:production:list": "playwright test -c playwright-production.config.ts --list",
    "test:visual": "VISUAL_RUN_ID=$(date -u +%Y%m%dT%H%M%SZ) playwright test -c playwright-visual.config.ts",
    "test:visual:list": "playwright test -c playwright-visual.config.ts --list",
    "test:web-performance": "playwright test -c playwright-web-performance.config.ts",
    "test:jbrowse": "playwright test -c playwright-jbrowse.config.ts",
    "test:jbrowse:list": "playwright test -c playwright-jbrowse.config.ts --list",
    "test:admin-console": "playwright test -c playwright-admin-console.config.ts",
    "test:admin-console:list": "playwright test -c playwright-admin-console.config.ts --list",
    "test:portal-embed": "playwright test -c playwright-portal-embed.config.ts",
    "test:portal-embed:list": "playwright test -c playwright-portal-embed.config.ts --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1"
  }
}