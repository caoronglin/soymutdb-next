{
  "name": "soymutdb",
  "version": "2.1.0",
  "private": true,
  "description": "SoyMutDB Next — comprehensive soybean mutant database with SSG public portal and web admin console",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:page-registry": "python3 scripts/check_page_registry.py",
    "check:web-query-keys": "python3 scripts/check_web_query_keys.py",
    "check:admin-content-architecture": "python3 scripts/check_admin_content_architecture.py",
    "test": "turbo run test",
    "smoke": "bash scripts/smoke.sh",
    "accept": "bash scripts/acceptance.sh",
    "dev:cloud": "bash scripts/start-cloud-dev.sh",
    "smoke:artifact": "bash scripts/verify-frontend-artifacts.sh --artifact-only",
    "dev:web": "pnpm --filter @soymutdb/web dev",
    "dev:admin": "pnpm --filter @soymutdb/admin dev",
    "build:web": "pnpm --filter @soymutdb/web build",
    "build:admin": "pnpm --filter @soymutdb/admin build",
    "build:ssg": "pnpm --filter @soymutdb/web ssg:routes",
    "deps:graphs": "python3 scripts/dependency_governance.py graphs --output artifacts/dependency-graphs",
    "deps:audit": "python3 scripts/dependency_governance.py audit --config dependency-governance.json --output artifacts/dependency-audit",
    "review": "python3 tools/code-review/review.py --project apps --output tools/code-review/reports/manual",
    "clean": "turbo run clean && rimraf node_modules",
    "ci:verify": "bash scripts/ci-job-steps.sh run frontend",
    "ci:api": "bash scripts/ci-job-steps.sh run api-tests",
    "ci:images": "bash scripts/ci-job-steps.sh run image-build",
    "ci:release": "bash scripts/ci-job-steps.sh run release",
    "ci:jobs": "bash scripts/ci-job-steps.sh list"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
