{
  "name": "soymutdb",
  "version": "2.0.0",
  "private": true,
  "description": "SoyMutDB Next — comprehensive soybean mutant database with SSG public portal and web admin console",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @soymutdb/web dev",
    "dev:admin": "pnpm --filter @soymutdb/admin dev:web",
    "build:web": "pnpm --filter @soymutdb/web build",
    "build:admin": "pnpm --filter @soymutdb/admin build:web",
    "build:ssg": "pnpm --filter @soymutdb/web ssg",
    "review": "python3 tools/code-review/review.py --project apps --output tools/code-review/reports/manual",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "rimraf": "^6.0.0",
    "eslint": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.66.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0"
  }
}
