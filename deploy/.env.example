# =====================================================================
# SoyMutDB 生产部署环境变量（docker compose 项目变量模板）
# =====================================================================
# 用法：
#   cp deploy/.env.example /opt/soymutdb/.env   # install.sh 会自动完成
#   然后编辑 /opt/soymutdb/.env 填入真实值。
# 注意：本文件是 docker compose 的变量源（compose 在项目目录读取 .env），
# 与前端 VITE_* 模板（项目根 .env.example）用途不同。
#
# 应用变量约定：所有传给 api/worker/beat/migrate 的变量使用 SOYMUTDB_ 前缀
# （与 apps/api/app/core/config.py 字段对齐，APP_ENV 取值仅 dev|staging|prod）。

# ------------------------------------------------------------------
# Compose capability profiles. Core is always enabled for the supported
# production path; JBrowse and Cloudflare Tunnel stay explicit opt-ins.
# ------------------------------------------------------------------
COMPOSE_PROFILES=core,blast,analyses,mcp

# ------------------------------------------------------------------
# 应用镜像（必填；只接受 CI 发布合同中的 image@sha256 引用）
# ------------------------------------------------------------------
API_IMAGE_REF=ghcr.io/caoronglin/api@sha256:1111111111111111111111111111111111111111111111111111111111111111
WORKER_IMAGE_REF=ghcr.io/caoronglin/worker@sha256:2222222222222222222222222222222222222222222222222222222222222222
MCP_IMAGE_REF=ghcr.io/caoronglin/mcp-server@sha256:3333333333333333333333333333333333333333333333333333333333333333
JBROWSE_IMAGE_REF=ghcr.io/caoronglin/jbrowse@sha256:4444444444444444444444444444444444444444444444444444444444444444
S3_GWAS_BUCKET=gwas
S3_ANALYSES_BUCKET=analyses

# ------------------------------------------------------------------
# 不可变静态发布目标凭据（Phase 3，可选；未配置的目标在 Admin 面板显示
# is_configured=false，不会出现在可发起发布的目标列表。凭据只存 env，
# 绝不落库、不进 API 响应 / 审计日志。）
# ------------------------------------------------------------------
# local 目标：本地发布根目录（worker 侧 SOYMUTDB_PUBLICATION_LOCAL_ROOT；
#        产物树写入 <root>/releases/<publication_id>/，current 符号链接原子切换）
# SOYMUTDB_PUBLICATION_LOCAL_ROOT=/opt/soymutdb/static
# GitHub Pages 目标（.github/workflows/pages.yml workflow_dispatch）：
# SOYMUTDB_GITHUB_PAGES_TOKEN=ghp_xxxx
# SOYMUTDB_GITHUB_PAGES_REPO=owner/repo     # 或 SOYMUTDB_GITHUB_REPOSITORY
# SOYMUTDB_GITHUB_API_ORIGIN=https://api.github.com
# Cloudflare Pages 目标（upload + promote）：
# SOYMUTDB_CLOUDFLARE_PAGES_API_TOKEN=xxxx
# SOYMUTDB_CLOUDFLARE_PAGES_ACCOUNT_ID=xxxx
# SOYMUTDB_CLOUDFLARE_PAGES_PROJECT=soymutdb-next
# 【待决策】SOYMUTDB_PUBLICATION_ARTIFACT_BUCKET=static-publications
#   配置字段已存在（config.py publication_artifact_bucket）但当前三适配器均未消费；
#   若后续将制品改为 S3 中转（github/cloudflare 从桶拉取）再启用。

# ------------------------------------------------------------------
# 可选 OLS4 插件 manifest（部署签名，默认关闭且 fail-closed）
# ------------------------------------------------------------------
# 生成一个至少 32 字符的部署专用 HMAC 密钥，并只通过受限的部署 secret
# 注入；不要把它提交到 Git、前端变量或数据库。
# SOYMUTDB_PLUGIN_MANIFEST_SIGNING_KEY=replace-with-a-secret-32-plus-character-key
# 使用已拉取的 API 镜像生成，与 API 内的 canonical signer 完全一致：
#   OLS4_PLUGIN_ENABLED=1 OLS4_PLUGIN_CONFIGURED=1 OLS4_PLUGIN_HEALTHY=1 \
#     bash deploy/scripts/render-ols4-plugin-manifest.sh
# 将 stdout 的单行 JSON 作为下列变量的值写入受限 .env。缺失或签名不匹配
# 时 API 将 OLS4 保持为 not_installed，不会隐式启用外部插件。
# SOYMUTDB_PLUGIN_MANIFESTS_JSON=<renderer-output>

# ------------------------------------------------------------------
# Cloudflare Tunnel（可选；docker compose --profile cloudflare-tunnel）
# ------------------------------------------------------------------
# 仅存 token 的文件路径，不要把 token 本身写入此文件、Git 或 VITE_* 变量。
# 文件应位于仓库外，归部署账户所有，权限为 0600；由 Compose secret 只读挂载。
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/soymutdb/secrets/cloudflare_tunnel_token
# 可选：部署后端到端探测目标（必须是 Tunnel 的 HTTPS 公共 API origin）。
# CLOUDFLARE_TUNNEL_HEALTH_URL=https://api.example.com/api/v1/health/live

# ------------------------------------------------------------------
# 数据存储凭据（生产必须修改，勿用默认值）
# ------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
# ClickHouse schema migration is run automatically by upgrade.sh in a one-shot
# Compose container; the host shell does not need SOYMUTDB_CLICKHOUSE_HOST.
# 缓存 Redis 与 Celery Redis（redis / redis-celery 两个实例共用此密码）
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=change-me-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ------------------------------------------------------------------
# Redis 职责隔离（compose 中两个独立实例，同一镜像 redis:7.4-alpine）
# ------------------------------------------------------------------
#   redis        = redis-cache 角色：allkeys-lru（可驱逐），仅 API 缓存/限流
#   redis-celery = Celery broker+result：noeviction + AOF（消息/结果不可丢）
# SOYMUTDB_REDIS_URL 语义不变（缓存），Celery 走 redis-celery 实例。
# 内存上限（默认 512mb，超出后缓存实例驱逐、celery 实例报 OOM 拒绝写入）：
# REDIS_CACHE_MAXMEMORY=512mb
# REDIS_CELERY_MAXMEMORY=512mb
# Celery result TTL（秒，默认 7 天；建议 1-7 天区间）：
# SOYMUTDB_CELERY_RESULT_EXPIRES=604800

# ------------------------------------------------------------------
# PostgreSQL 连接预算（默认 max_connections=100，应用总预算 <= 80）
# ------------------------------------------------------------------
# 默认：api 5+5 + 3 个 worker 各 2+4 + migrate 1 + 运维余量 ≈ 40（<= 80）。
# 调大 pool 时需同步调大 postgres max_connections（compose 未显式覆盖默认值）。
# API 侧（apps/api/app/core/config.py 字段）：
# SOYMUTDB_DB_POOL_SIZE=5
# SOYMUTDB_DB_MAX_OVERFLOW=5
# SOYMUTDB_DB_POOL_TIMEOUT=30
# SOYMUTDB_DB_POOL_RECYCLE=1800
# SOYMUTDB_DB_POOL_PRE_PING=true
# Worker 侧（每个 worker 进程的同步 engine，API 会忽略这些变量）：
# SOYMUTDB_WORKER_DB_POOL_SIZE=2
# SOYMUTDB_WORKER_DB_MAX_OVERFLOW=4

# ------------------------------------------------------------------
# API 生产必填（apps/api/app/core/config.py fail-fast 校验：
# 缺失或使用开发默认值时 API 拒绝启动，upgrade.sh 会预检）
# ------------------------------------------------------------------
# JWT 签名密钥：至少 32 字符，禁止示例值
SOYMUTDB_JWT_SECRET=please-generate-a-random-secret-of-32-plus-characters
# CORS 允许来源（逗号分隔，无通配符；启用凭据时 '*' 会被拒绝）
SOYMUTDB_CORS_ORIGINS=https://soymutdb.org,https://www.soymutdb.org

# ------------------------------------------------------------------
# 可选调优
# ------------------------------------------------------------------
# Celery worker 并发（worker-default / worker-ingest / worker-blast）
WORKER_DEFAULT_CONCURRENCY=4
WORKER_INGESTION_CONCURRENCY=2
WORKER_BLAST_CONCURRENCY=2
WORKER_ANALYSES_CONCURRENCY=2

# ------------------------------------------------------------------
# 邮件发送（SMTP，D1 种子申请等联络模块）
# ------------------------------------------------------------------
# 默认 smtp_enabled=false：不真发邮件，worker 将渲染后的邮件写入
# logs/emails/（开发验证用）。生产必须显式开启并配置真实 SMTP 凭据；
# api 与 worker 都读取同一组 SOYMUTDB_SMTP_* 变量。
SOYMUTDB_SMTP_ENABLED=false
SOYMUTDB_SMTP_HOST=localhost
SOYMUTDB_SMTP_PORT=587
SOYMUTDB_SMTP_USERNAME=
SOYMUTDB_SMTP_PASSWORD=
# 发件人地址（默认 no-reply@soymutdb.local）
SOYMUTDB_SMTP_FROM_EMAIL=no-reply@soymutdb.local
# STARTTLS（true=587 常用；false=465 隐式 TLS 场景请配合端口）
SOYMUTDB_SMTP_USE_TLS=true
# 管理员通知收件人（默认取 SOYMUTDB_ADMIN_EMAIL）
SOYMUTDB_SMTP_ADMIN_TO=admin@soymutdb.org
# 管理员通知邮件中的处理链接前缀（站点公开地址，如 https://soymutdb.org）
# SOYMUTDB_PUBLIC_BASE_URL=https://soymutdb.org

# 监控（Grafana）
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana

# 发布脚本（deploy/scripts/upgrade.sh）
# readiness 轮询次数（每次间隔 5s，默认 60 次 = 300s）
# READY_RETRIES=60
# API 就绪地址（默认经 nginx 的 http://localhost:8080）
# API_HOST=localhost
# API_PORT=8080
