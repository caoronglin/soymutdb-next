# =====================================================================
# SoyMutDB — 核心功能部署的最小变量文件（docker compose 项目变量）
# =====================================================================
# 只部署数据库产品的核心：PostgreSQL / ClickHouse / Redis / MinIO / API /
# worker-default / worker-ingest / beat / nginx / 监控。
# 不启动 jbrowse / blast / analyses / mcp —— 它们各自的 profile 默认关闭。
#
# 用法：
#   cp deploy/.env.core-only.example .env     # 放到 docker-compose.yml 同目录
#   docker compose --profile core up -d
#
# 本文件只列 core 的必填项；完整变量、注释与可选目标见 deploy/.env.example。

# 只启用 core。需要某个可选服务时再叠加 profile，例如：
#   COMPOSE_PROFILES=core,jbrowse
#   COMPOSE_PROFILES=core,blast
COMPOSE_PROFILES=core

# ------------------------------------------------------------------
# 应用镜像（必填；CI 发布合同只接受 image@sha256 引用）
# ------------------------------------------------------------------
API_IMAGE_REF=ghcr.io/OWNER/api@sha256:<64-hex>
WORKER_IMAGE_REF=ghcr.io/OWNER/worker@sha256:<64-hex>
MIGRATE_IMAGE_REF=ghcr.io/OWNER/migrate@sha256:<64-hex>
MIGRATE_CLICKHOUSE_IMAGE_REF=ghcr.io/OWNER/migrate-clickhouse@sha256:<64-hex>

# ------------------------------------------------------------------
# 数据层凭据（必填；改成强随机值）
# ------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=soymutdb
MINIO_ROOT_PASSWORD=change-me-minio

# ------------------------------------------------------------------
# 应用（必填）
# ------------------------------------------------------------------
SOYMUTDB_JWT_SECRET=change-me-at-least-32-characters-long
SOYMUTDB_CORS_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------
# 监控（core profile 会启动 grafana，必填）
# ------------------------------------------------------------------
GRAFANA_PASSWORD=change-me-grafana

# ------------------------------------------------------------------
# 可选服务（核心部署不需要；留空/注释即可，这些 profile 未启用）
# ------------------------------------------------------------------
# JBROWSE_IMAGE_REF=ghcr.io/OWNER/jbrowse@sha256:<64-hex>
# MCP_IMAGE_REF=ghcr.io/OWNER/mcp-server@sha256:<64-hex>
# SOYMUTDB_MCP_API_TOKEN=change-me-mcp-token
