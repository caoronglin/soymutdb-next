[Unit]
Description=SoyMutDB FastAPI baseline API (native, no Docker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@/current/apps/api
EnvironmentFile=-@ENV_FILE@
ExecStart=@INSTALL_DIR@/current/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@INSTALL_DIR@

[Install]
WantedBy=multi-user.target
