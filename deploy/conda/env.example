# =====================================================================
# SoyMutDB Conda / 无 Docker 部署环境变量模板
# =====================================================================
# 用途：deploy/scripts/conda-deploy.sh 会复制本文件到 $INSTALL_DIR/.env。
# 与 docker compose 主路径不同：这里的 SOYMUTDB_* 变量是应用层（api/worker/beat）
# 真正读取的变量；数据层可以是本机服务、远程实例，或 docker 只起数据服务。
#
# 使用：
#   cp deploy/conda/env.example /opt/soymutdb/.env
#   然后至少修改：SOYMUTDB_JWT_SECRET / SOYMUTDB_CORS_ORIGINS /
#   SOYMUTDB_DATABASE_URL / SOYMUTDB_CLICKHOUSE_* / SOYMUTDB_REDIS_URL /
#   SOYMUTDB_CELERY_* / SOYMUTDB_S3_* 及数据存储凭据。

# ------------------------------------------------------------------
# 运行模式
# ------------------------------------------------------------------
SOYMUTDB_APP_ENV=prod

# ------------------------------------------------------------------
# API / Worker 生产必填
# ------------------------------------------------------------------
# JWT 密钥：至少 32 字符
SOYMUTDB_JWT_SECRET=please-generate-a-random-secret-of-32-plus-characters
# CORS 允许来源（逗号分隔，禁止通配符）
SOYMUTDB_CORS_ORIGINS=https://soymutdb.org,http://localhost:5173

# ------------------------------------------------------------------
# PostgreSQL（API 用 asyncpg，worker 自动映射为 psycopg）
# ------------------------------------------------------------------
SOYMUTDB_DATABASE_URL=postgresql+asyncpg://soymutdb:change-me-postgres@127.0.0.1:5432/soymutdb
# worker 侧连接池（每个 worker 进程）
SOYMUTDB_WORKER_DB_POOL_SIZE=2
SOYMUTDB_WORKER_DB_MAX_OVERFLOW=4

# ------------------------------------------------------------------
# ClickHouse
# ------------------------------------------------------------------
SOYMUTDB_CLICKHOUSE_HOST=127.0.0.1
SOYMUTDB_CLICKHOUSE_PORT=8123
SOYMUTDB_CLICKHOUSE_USER=soymutdb
SOYMUTDB_CLICKHOUSE_PASSWORD=change-me-clickhouse
SOYMUTDB_CLICKHOUSE_DATABASE=soymutdb

# ------------------------------------------------------------------
# Redis（两个独立实例，职责隔离）
#   缓存实例：allkeys-lru，可驱逐
#   Celery 实例：noeviction + AOF，消息/结果不可丢
# 若本机只有一个 Redis，至少要用不同 db；生产建议两个实例。
# ------------------------------------------------------------------
SOYMUTDB_REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0
SOYMUTDB_CELERY_BROKER_URL=redis://:change-me-redis@127.0.0.1:6380/0
SOYMUTDB_CELERY_RESULT_BACKEND=redis://:change-me-redis@127.0.0.1:6380/1
SOYMUTDB_CELERY_RESULT_EXPIRES=604800

# ------------------------------------------------------------------
# MinIO / S3
# ------------------------------------------------------------------
SOYMUTDB_S3_ENDPOINT=http://127.0.0.1:9000
SOYMUTDB_S3_ACCESS_KEY=change-me-minio-admin
SOYMUTDB_S3_SECRET_KEY=change-me-minio-password
# 桶名（scripts 初始化时创建）
SOYMUTDB_S3_PUBLIC_BUCKET=genomic-data
SOYMUTDB_S3_PRIVATE_BUCKET=user-tracks
SOYMUTDB_S3_BLAST_BUCKET=blast-dbs
SOYMUTDB_S3_EXPORT_BUCKET=exports
SOYMUTDB_S3_GWAS_BUCKET=gwas
SOYMUTDB_S3_ANALYSES_BUCKET=analyses

# ------------------------------------------------------------------
# SMTP（默认关闭；开启后必须配置真实 SMTP）
# ------------------------------------------------------------------
SOYMUTDB_SMTP_ENABLED=false
SOYMUTDB_SMTP_HOST=localhost
SOYMUTDB_SMTP_PORT=587
SOYMUTDB_SMTP_USERNAME=
SOYMUTDB_SMTP_PASSWORD=
SOYMUTDB_SMTP_FROM_EMAIL=no-reply@soymutdb.local
SOYMUTDB_SMTP_USE_TLS=true
SOYMUTDB_SMTP_ADMIN_TO=admin@soymutdb.org
# SOYMUTDB_PUBLIC_BASE_URL=https://soymutdb.org

# ------------------------------------------------------------------
# 可选：API 连接池
# ------------------------------------------------------------------
# SOYMUTDB_DB_POOL_SIZE=5
# SOYMUTDB_DB_MAX_OVERFLOW=5
# SOYMUTDB_DB_POOL_TIMEOUT=30
# SOYMUTDB_DB_POOL_RECYCLE=1800
# SOYMUTDB_DB_POOL_PRE_PING=true
