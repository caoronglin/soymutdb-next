{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/generated/**",
    "**/node_modules/**",
    "**/playwright-report*/**",
    "**/test-results*/**",
    "packages/charts/src/g2-runtime.ts"
  ],
  "exclude": [
    "unlisted",
    "binaries"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "python3"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "@types/react-dom",
    "autoprefixer",
    "openapi-typescript",
    "postcss",
    "react-dom",
    "tailwindcss",
    "vite"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-react-entry-graph.mjs",
        "scripts/check-react-entry-graph.test.mjs",
        "scripts/check-vue-retirement.mjs",
        "scripts/check_visible_i18n_react.mjs",
        "scripts/test_visible_i18n_react_guard.mjs",
        "scripts/check-admin-i18n-keys.mjs",
        "scripts/test_admin_i18n_keys_guard.mjs",
        "scripts/dev/local-preview-server.mjs",
        "tests/load/api-load.js",
        "tests/load/smoke.js",
        "tests/load/variant-stress.js",
        "scripts/scan-ant-design.mjs",
        "scripts/webpack/chart-closure-plugin.cjs",
        "scripts/webpack/chart-split-groups.ts"
      ]
    },
    "e2e": {
      "entry": [
        "playwright*.config.ts",
        "tests/*.spec.ts",
        "*.mjs"
      ],
      "project": [
        "**/*.ts",
        "**/*.mjs"
      ],
      "playwright": {
        "config": []
      }
    },
    "apps/web": {
      "entry": [
        "config/config.ts",
        "config/plugins/defer-html-scripts.cjs",
        "public/sw.js",
        "src/umi-entry.tsx",
        "src/routes/**/*.tsx",
        "scripts/finalize-csp.ts",
        "scripts/release-manifest.ts",
        "scripts/gen-sw.js"
      ]
    },
    "apps/admin": {
      "entry": [
        "config/config.ts",
        "config/plugins/defer-html-scripts.cjs",
        "src/umi-entry.tsx",
        "src/routes/**/*.tsx",
        "src/test/antd-double.tsx",
        "src/test/mocks.ts",
        "src/test/vitest-env.d.ts"
      ]
    },
    "apps/jbrowse": {
      "entry": [
        "config/config.ts",
        "src/umi-entry.tsx"
      ]
    },
    "packages/genome-view": {
      "entry": [
        "scripts/gen-svg-golden.ts"
      ]
    }
  }
}
