{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/generated/**",
    "**/node_modules/**",
    "**/playwright-report*/**",
    "**/test-results*/**"
  ],
  "exclude": [
    "files",
    "exports",
    "types",
    "unlisted",
    "binaries"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "python3",
    "playwright"
  ],
  "ignoreDependencies": [
    "@soymutdb/shared",
    "@testing-library/jest-dom",
    "ansi-regex",
    "autoprefixer",
    "openapi-typescript",
    "postcss-load-config",
    "tailwindcss"
  ],
  "workspaces": {
    "e2e": {
      "entry": [
        "playwright*.config.ts",
        "tests/*.spec.ts",
        "*.mjs"
      ],
      "project": [
        "**/*.ts",
        "**/*.mjs"
      ],
      "playwright": {
        "config": []
      }
    },
    "apps/web": {
      "entry": [
        "config/config.ts",
        "config/plugins/defer-html-scripts.cjs",
        "src/umi-entry.tsx",
        "src/routes/**/*.tsx",
        "scripts/finalize-csp.ts",
        "scripts/release-manifest.ts",
        "scripts/gen-sw.js"
      ]
    },
    "apps/admin": {
      "entry": [
        "config/config.ts",
        "config/plugins/defer-html-scripts.cjs",
        "src/umi-entry.tsx",
        "src/routes/**/*.tsx",
        "src/test/setup.ts"
      ]
    },
    "apps/jbrowse": {
      "entry": [
        "config/config.ts",
        "src/umi-entry.tsx"
      ]
    }
  }
}
