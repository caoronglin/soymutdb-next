{
  "name": "@soymutdb/genome-data",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral genome data access: @gmod readers over FASTA/VCF/GFF3/BigWig/BigBed/Trix with assembly-scoped normalized records.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@gmod/bbi": "catalog:genomics",
    "@gmod/indexedfasta": "catalog:genomics",
    "@gmod/tabix": "catalog:genomics",
    "@gmod/trix": "catalog:genomics",
    "@gmod/vcf": "catalog:genomics",
    "generic-filehandle": "catalog:genomics"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
