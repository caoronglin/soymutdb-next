{
  "name": "@soymutdb/ui-vue",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vue UI facade over Antdv Next — the only module allowed to import the design system (plan D4)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@soymutdb/shared": "workspace:*",
    "antdv-next": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.0"
  }
}
