{
  "name": "@soymutdb/i18n",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Internationalization (i18next) resources and config for SoyMutDB",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "check-locale-keys.mjs"
  ],
  "scripts": {
    "check:locale-keys": "node check-locale-keys.mjs",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@soymutdb/i18n-core": "workspace:*",
    "i18next": "^24.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
