{
  "name": "@soymutdb/api-client",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Typed API client for SoyMutDB (fetch-based with auth interceptors)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "error-codes.json"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "generate:api-client": "bash scripts/generate-api-client.sh",
    "check:contract": "bash scripts/check-contract.sh"
  },
  "dependencies": {
    "@soymutdb/shared": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^26.6.5"
  }
}
