{
  "name": "@soymutdb/i18n-core",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral i18n catalogs, language detection and base i18next options",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./locales/en/common.json": "./src/locales/en/common.json",
    "./locales/zh/common.json": "./src/locales/zh/common.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "check-locale-keys.mjs"
  ],
  "scripts": {
    "test": "vitest run",
    "check:locale-keys": "node check-locale-keys.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
