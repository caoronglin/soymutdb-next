# =====================================================================
# SoyMutDB Web Frontend Dockerfile
# node:24.19.0-alpine, pnpm, multi-stage build
# Includes SSG build + gzip pre-compression for gzip_static
# =====================================================================

# ---------- Stage 1: Dependencies ----------
FROM node:24.19.0-alpine AS deps

RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/i18n/package.json ./packages/i18n/

RUN pnpm install --frozen-lockfile

# ---------- Stage 2: Builder ----------
FROM node:24.19.0-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages ./packages

COPY . .

ENV NODE_ENV=production

# Container path only: the build emits .gz siblings for nginx gzip_static.
# The Pages/gh-pages path (scripts/build-sites.ts) leaves this unset so the
# published tree is not doubled. See docs/ops/production-build.md.
ENV SOYMUTDB_EMIT_GZ=1

# Build the web frontend (includes SSG via vite build + code splitting)
RUN pnpm --filter @soymutdb/web build

# Pre-compress static assets with gzip for gzip_static support.
# Shared script (infra/docker/precompress.sh) is used by both web and admin.
# Idempotent: the build above already wrote .gz for .html/.css/.js/…; this pass
# adds the font extensions the build chain does not cover.
COPY infra/docker/precompress.sh /tmp/precompress.sh
RUN sh /tmp/precompress.sh apps/web/dist

# Ensure /samples/ directory exists (SSG sample pages go here)
RUN mkdir -p apps/web/dist/samples

# ---------- Stage 3: Runtime ----------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/web-nginx.conf /etc/nginx/conf.d/default.conf
# The server config includes this fragment at server and location level;
# a missing include is an `nginx: [emerg]` startup failure, so the file
# must exist in the image. Shared by every HTML-serving nginx image.
COPY infra/nginx/conf.d/security-headers.inc /etc/nginx/conf.d/security-headers.inc

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --spider -q http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
