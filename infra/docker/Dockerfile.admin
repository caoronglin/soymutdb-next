# =====================================================================
# SoyMutDB Admin Console Dockerfile
# node:24.19.0-alpine, pnpm, multi-stage build (same structure as web)
# Includes gzip pre-compression for gzip_static support.
# No host port exposure — admin is only reachable via reverse proxy with IP ACL.
# =====================================================================

# ---------- Stage 1: Dependencies ----------
FROM node:24.19.0-alpine AS deps

RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/i18n/package.json ./packages/i18n/

RUN pnpm install --frozen-lockfile

# ---------- Stage 2: Builder ----------
FROM node:24.19.0-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=deps /app/packages ./packages

COPY . .

ENV NODE_ENV=production

# Container path only: nginx gzip_static serves the .gz siblings.
ENV SOYMUTDB_EMIT_GZ=1

RUN pnpm --filter @soymutdb/admin build

# Pre-compress static assets with gzip for gzip_static support.
# Shared script (infra/docker/precompress.sh) is used by both web and admin.
# Idempotent; the admin build chain emits no .gz of its own, so this pass is
# what produces them.
COPY infra/docker/precompress.sh /tmp/precompress.sh
RUN sh /tmp/precompress.sh apps/admin/dist

# ---------- Stage 3: Runtime ----------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
COPY infra/docker/admin-nginx.conf /etc/nginx/conf.d/default.conf
# Admin uses its own stricter fragment (DENY framing, no-referrer,
# script-src 'self'); see infra/nginx/conf.d/security-headers-admin.inc.
COPY infra/nginx/conf.d/security-headers-admin.inc /etc/nginx/conf.d/security-headers-admin.inc

# NOTE: No port mapping to host in docker-compose.yml.
# Admin is only accessible via the nginx reverse proxy at /admin/
# with IP allowlist enforcement (private networks only).
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --spider -q http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
