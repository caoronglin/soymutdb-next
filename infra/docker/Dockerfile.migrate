# =====================================================================
# SoyMutDB migrate Dockerfile — the one-shot `alembic upgrade head` runner
# =====================================================================
# Why a dedicated image
#   The production Compose topology runs migrations as a one-shot service, but
#   used to resolve that service through `API_IMAGE_REF`:
#
#     migrate:
#       image: ${API_IMAGE_REF:?…}
#       command: [ "alembic", "upgrade", "head" ]
#
#   Consequence: the migration step was pinned to the API image *tag* while the
#   api/worker services moved to the release *digest*. A publish that updated
#   only the digest references therefore ran the previous release's migrations.
#   The image below removes the coupling: migrate, api and worker are three
#   independent digest references of the same release, each with its own build.
#
#   The second reason is size. `alembic` needs the migration environment, the
#   ORM metadata and `asyncpg`, so this image does contain the API project — but
#   it contains nothing else. apps/api pins its whole dependency set in
#   `[project].dependencies` (uvicorn[standard] included), so there is no
#   `runtime` extra to subtract; the image is a slim python base plus that set,
#   with no server process, no bioinformatics toolchain and no worker.
#
# Contract (asserted by scripts/test_dockerfile_contracts.py)
#   * WORKDIR is /app/apps/api, which is where `alembic.ini` lives, so the
#     Compose command `alembic upgrade head` works without `-c`.
#   * `packages/jobs-py` and `packages/import-protocol` are COPYed before
#     `uv sync`: apps/api depends on both by path, so a sync without them cannot
#     resolve the lockfile.
#   * No `COPY` may be added after the last `uv sync --frozen` — a late copy that
#     adds dependencies would produce an image whose venv disagrees with the
#     lockfile (see scripts/check-dockerfile-copy.sh).
# =====================================================================

# ---------- Stage 1: Builder ----------
FROM python:3.14.6-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /usr/local/bin/uv

WORKDIR /app

# The workspace packages apps/api depends on by path must be present before
# `uv sync` resolves the lockfile.
COPY apps/api/pyproject.toml apps/api/uv.lock ./apps/api/
COPY packages/jobs-py ./packages/jobs-py
COPY packages/import-protocol ./packages/import-protocol

RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --no-dev --no-install-project \
      --project apps/api

# Last COPY of the build: no dependency may be introduced after the sync above.
COPY apps/api ./apps/api

# ---------- Stage 2: Runtime ----------
FROM python:3.14.6-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    SOYMUTDB_APP_ENV=prod

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 soymutdb \
    && useradd --uid 1000 --gid soymutdb --shell /bin/bash --create-home soymutdb

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=soymutdb:soymutdb /app /app

# alembic.ini resolves `script_location = migrations` and the pre/post hooks
# import `app.*` relatively, so the working directory is load-bearing.
WORKDIR /app/apps/api

USER soymutdb

# No HEALTHCHECK and no long-running CMD: this image is a one-shot job. The
# Compose service overrides the command and the platform waits for
# `service_completed_successfully`. The image is still smoke-tested in CI with
# `alembic heads`, which proves the migrations directory and the environment
# resolve without a database.
CMD ["alembic", "upgrade", "head"]
