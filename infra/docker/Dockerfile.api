# =====================================================================
# SoyMutDB API Dockerfile
# Multi-stage build with uv, non-root user, HEALTHCHECK
# =====================================================================

# ---------- Stage 1: Builder ----------
FROM python:3.14.6-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /usr/local/bin/uv

WORKDIR /app

COPY apps/api/pyproject.toml apps/api/uv.lock ./apps/api/
COPY packages/jobs-py ./packages/jobs-py
COPY packages/import-protocol ./packages/import-protocol

RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --no-dev --no-install-project --project apps/api

COPY apps/api ./apps/api

# ---------- Stage 2: Runtime ----------
FROM python:3.14.6-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    SOYMUTDB_APP_ENV=prod \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 soymutdb \
    && useradd --uid 1000 --gid soymutdb --shell /bin/bash --create-home soymutdb

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=soymutdb:soymutdb /app /app

WORKDIR /app/apps/api

USER soymutdb

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8010/api/v1/health/live', timeout=5)"

# Remove stale mmap files before Uvicorn spawns workers, then use exec so
# SIGTERM reaches the supervisor and drains children within the grace budget.
CMD ["sh", "-c", "mkdir -p /tmp/prometheus-multiproc && rm -f /tmp/prometheus-multiproc/*.db && exec uvicorn app.main:app --host 0.0.0.0 --port 8010 --workers ${SOYMUTDB_API_WORKERS:-2} --timeout-graceful-shutdown ${SOYMUTDB_API_GRACEFUL_SHUTDOWN_SECONDS:-30} --proxy-headers --forwarded-allow-ips=${SOYMUTDB_FORWARDED_ALLOW_IPS:-*}"]
