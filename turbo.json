{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["VITE_API_BASE_URL", "VITE_JBROWSE_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "CI",
        "CONTENT_SNAPSHOT_URL",
        "NODE_ENV",
        "SITE_BASE_URL",
        "SOYMUTDB_API_URL",
        "SOYMUTDB_FETCH_TIMEOUT",
        "SOYMUTDB_RELEASE_ID",
        "SOYMUTDB_SITE_URL",
        "VITE_API_BASE_URL",
        "VITE_BASE_URL",
        "VITE_CLOUDFLARE_ANALYTICS_TOKEN",
        "VITE_DEMO_MODE",
        "VITE_DEPLOYMENT_MODE",
        "VITE_JBROWSE_BASE_URL",
        "VITE_JBROWSE_DATA_URL",
        "VITE_JBROWSE_URL",
        "VITE_PUBLIC_URL",
        "VITE_SW_ENABLED"
      ]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
