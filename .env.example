# SoyMutDB Frontend Environment Variables
# NOTE: 本文件是前端构建（VITE_*）模板。生产部署（docker compose）的环境
# 变量模板见 deploy/.env.example（SOYMUTDB_* 前缀、镜像 tag、密钥等）。

# API base URL (backend REST API)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# JBrowse standalone deployment base URL
VITE_JBROWSE_BASE_URL=http://localhost:3002

# Default genome assembly
VITE_DEFAULT_ASSEMBLY=Wm82v4.0

# CDN externals — when enabled, GSAP/Lenis/ECharts load from CDN instead of bundle.
# Default: false (bundled). Set to true for production with reliable CDN access.
# Restricted-network deployments (air-gapped, university labs) should keep false.
VITE_CDN_ENABLED=false

# CDN URLs (only used when VITE_CDN_ENABLED=true)
# Leave empty to bundle that specific library even when CDN is enabled.
VITE_GSAP_CDN=https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js
VITE_GSAP_SCROLLTRIGGER_CDN=https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/ScrollTrigger.min.js
VITE_ECHARTS_CDN=https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js
VITE_LENIS_CDN=https://cdn.jsdelivr.net/npm/lenis@1.3.23/dist/lenis.min.js
