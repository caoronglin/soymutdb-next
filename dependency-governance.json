    {
      "name": "pnpm-audit",
      "category": "vulnerabilities",
      "command": [
        "pnpm",
        "audit",
        "--registry",
        "https://registry.npmjs.org/",
        "--json",
        "--audit-level",
        "high"
      ],
      "report": {
        "mode": "stdout",
        "path": "pnpm-audit.json",
        "format": "json"
      }
    },
    {
      "name": "pip-audit-api",
      "category": "vulnerabilities",
      "command": [
        "bash",
        "-c",
        "uv export --locked --project {root}/apps/api --format requirements-txt --no-dev --no-emit-project --no-emit-local --output-file /tmp/soymutdb-api-audit-requirements.txt && uvx --from pip-audit==2.9.0 pip-audit --cache-dir /tmp/soymutdb-pip-audit-cache --strict --format json --output {output_dir}/pip-audit-api.json --requirement /tmp/soymutdb-api-audit-requirements.txt"
      ],
      "report": {
        "mode": "file",
        "path": "pip-audit-api.json",
        "format": "json"
      }
    },
    {
      "name": "pip-audit-worker",
      "category": "vulnerabilities",
      "command": [
        "bash",
        "-c",
        "uv export --locked --project {root}/apps/worker --format requirements-txt --no-dev --no-emit-project --no-emit-local --output-file /tmp/soymutdb-worker-audit-requirements.txt && uvx --from pip-audit==2.9.0 pip-audit --cache-dir /tmp/soymutdb-pip-audit-cache --strict --format json --output {output_dir}/pip-audit-worker.json --requirement /tmp/soymutdb-worker-audit-requirements.txt"
